{
  "name": "nodoskatepark",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "nx run-many -t test",
    "build": "nx run-many -t build",
    "up": "docker compose up --build",
    "down": "docker compose down",
    "logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "nx": "20.3.2",
    "typescript": "5.7.3"
  }
}
