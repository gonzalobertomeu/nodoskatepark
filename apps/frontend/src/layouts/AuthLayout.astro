---
import '../styles/tokens.css';
import '../styles/neobrutalist.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — NodoSkatepark</title>
  </head>
  <body>
    <main class="nb-page">
      <slot />
    </main>
  </body>
</html>
