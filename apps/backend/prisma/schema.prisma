generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountRole {
  skater
  instructor
  administrador
}

enum AccountStatus {
  active
  deactivated
}

model Account {
  id                String        @id @default(uuid())
  email             String        @unique
  passwordHash      String?
  googleId          String?       @unique
  role              AccountRole   @default(skater)
  status            AccountStatus @default(active)
  emailVerifiedAt   DateTime?
  failedAttempts    Int           @default(0)
  lockedUntil       DateTime?
  nombre            String?
  apellido          String?
  fechaDeNacimiento DateTime?
  apodo             String?
  afeccionesDeSalud String?
  fotoPath          String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  sessions              Session[]
  passwordResetRequests PasswordResetRequest[]
  healthAuditLogsAsSkater  SkaterHealthAuditLog[] @relation("SkaterHealthAuditLogSkater")
  healthAuditLogsAsEditor  SkaterHealthAuditLog[] @relation("SkaterHealthAuditLogEditor")
  instructorInvitationsCreated InstructorInvitation[] @relation("InstructorInvitationCreatedBy")
  instructorInvitationsResolved InstructorInvitation[] @relation("InstructorInvitationResolvedAccount")
  roleAssignmentsAsAdmin RoleAssignmentAuditLog[] @relation("RoleAssignmentAuditLogAdmin")
  roleAssignmentsAsTarget RoleAssignmentAuditLog[] @relation("RoleAssignmentAuditLogTarget")

  @@map("accounts")
}

model SkaterHealthAuditLog {
  id                String   @id @default(uuid())
  skaterAccountId   String
  skaterAccount     Account  @relation("SkaterHealthAuditLogSkater", fields: [skaterAccountId], references: [id])
  editedByAccountId String
  editedByAccount   Account  @relation("SkaterHealthAuditLogEditor", fields: [editedByAccountId], references: [id])
  editedAt          DateTime @default(now())

  @@index([skaterAccountId])
  @@map("skater_health_audit_log")
}

enum PasswordResetStatus {
  pending
  used
  expired
}

model PasswordResetRequest {
  id        String               @id @default(uuid())
  accountId String
  account   Account              @relation(fields: [accountId], references: [id])
  token     String               @unique
  expiresAt DateTime
  status    PasswordResetStatus  @default(pending)
  createdAt DateTime             @default(now())

  @@index([accountId])
  @@map("password_reset_requests")
}

enum SessionAuthMethod {
  password
  google
}

model Session {
  id         String            @id @default(uuid())
  accountId  String
  account    Account           @relation(fields: [accountId], references: [id])
  authMethod SessionAuthMethod
  createdAt  DateTime          @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([accountId])
  @@map("sessions")
}

enum InstructorInvitationStatus {
  pending
  cancelled
  resolved
}

model InstructorInvitation {
  id                String                      @id @default(uuid())
  email             String
  createdByAdminId  String
  createdByAdmin    Account                     @relation("InstructorInvitationCreatedBy", fields: [createdByAdminId], references: [id])
  status            InstructorInvitationStatus  @default(pending)
  createdAt         DateTime                    @default(now())
  resolvedAccountId String?
  resolvedAccount   Account?                    @relation("InstructorInvitationResolvedAccount", fields: [resolvedAccountId], references: [id])
  resolvedAt        DateTime?
  cancelledAt       DateTime?

  @@index([email])
  @@map("instructor_invitations")
}

enum RoleAssignmentMethod {
  existing_user
  email_invite
}

model RoleAssignmentAuditLog {
  id              String                @id @default(uuid())
  adminAccountId  String
  adminAccount    Account               @relation("RoleAssignmentAuditLogAdmin", fields: [adminAccountId], references: [id])
  targetAccountId String?
  targetAccount   Account?              @relation("RoleAssignmentAuditLogTarget", fields: [targetAccountId], references: [id])
  targetEmail     String
  method          RoleAssignmentMethod
  createdAt       DateTime              @default(now())

  @@index([targetAccountId])
  @@map("role_assignment_audit_log")
}

/// Declaration order IS the order of the week: Postgres orders an enum by position, so
/// `ORDER BY "dayOfWeek"` returns the grid in order with no translation table
/// (007-class-schedule-config, data-model.md).
enum DayOfWeek {
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
  sunday
}

enum ClassAgeGroup {
  menores
  adultos
}

enum ClassLevel {
  iniciantes
  intermedios
  avanzados
}

/// A weekly class slot. Recurs on its weekday until edited or deleted (FR-007); it carries no
/// date, which is what makes recurrence true by construction and makes "what the grid looked like
/// three months ago" unanswerable by design (FR-025a).
///
/// Hours are MINUTES SINCE MIDNIGHT, never a DateTime: local wall-clock time that no seasonal
/// clock change can shift and that no driver can convert (FR-018a).
///
/// No relation to Account on purpose: a class has no assigned instructor and no attendees — that
/// is the attendance feature's own data (FR-029).
model ScheduledClass {
  id             String        @id @default(uuid())
  dayOfWeek      DayOfWeek
  startsAtMinute Int
  endsAtMinute   Int
  ageGroup       ClassAgeGroup
  level          ClassLevel
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([dayOfWeek, startsAtMinute])
  @@map("scheduled_classes")
}

/// Opening hours, one row per weekday. Three states, and two of them are opposites:
///   - no row       -> unconfigured: classes are allowed with no restriction (FR-018)
///   - closed=true  -> closed: no class is allowed that day (FR-015a)
///   - closed=false -> open: classes must fall inside the range (FR-014)
/// Collapsing the first two would make a day nobody touched indistinguishable from one closed on
/// purpose, and FR-018 could no longer be satisfied.
model SkateparkHours {
  dayOfWeek      DayOfWeek @id
  closed         Boolean   @default(false)
  opensAtMinute  Int?
  closesAtMinute Int?
  updatedAt      DateTime  @updatedAt

  @@map("skatepark_hours")
}
