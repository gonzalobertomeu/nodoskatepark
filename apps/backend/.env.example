# Copy to apps/backend/.env (gitignored). docker compose auto-loads it to fill in the
# ${VAR:-default} placeholders in apps/backend/compose.yaml — every var below already has a
# working dev default there, so `bun run up` boots without this file at all. Only needed to test
# a real Google sign-in or send real outgoing email.
#
# DATABASE_URL, SESSION_*, GOOGLE_CALLBACK_URL, FRONTEND_URL and PORT are fixed in
# apps/backend/compose.yaml for the container network and aren't read from here.

# Google OAuth2 client (only required to complete a real Google sign-in — see quickstart.md
# Scenario 2). Leave unset to use safe placeholders that let the backend boot without real SSO.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (resend.com) — the monorepo's sole email delivery provider (only used if
# EMAIL_ADAPTER=resend — the default EMAIL_ADAPTER=dev instead captures password-reset/
# verification emails in the backend container's logs).
EMAIL_ADAPTER=dev
RESEND_API_KEY=
EMAIL_FROM=NodoSkatepark <no-reply@nodoskatepark.com>

# HMAC secret for email-verification tokens — set a real random value outside of local dev.
EMAIL_VERIFICATION_SECRET=dev-only-insecure-secret
